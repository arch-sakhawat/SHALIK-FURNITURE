# ==============================================================================
# .gitignore for Shalik Furniture Suite
# ==============================================================================

# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Staging build directories (generated by build scripts)
yak_stage/
installer/payload/

# Visual Studio / Editor caches
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Operating System files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.log
